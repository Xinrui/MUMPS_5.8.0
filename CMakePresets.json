{
	"version": 6,
	"configurePresets": [
		{
			"name": "default",
			"hidden": false,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "icx",
				"CMAKE_Fortran_COMPILER": "ifx",
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
				"BUILD_SHARED_LIBS": "ON"
			}
		}
	]
}